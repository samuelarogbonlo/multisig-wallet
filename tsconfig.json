{
    "compilerOptions": {
      "target": "es2020",
      "module": "commonjs",
      "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "outDir": "dist",
      "declaration": true,
      "sourceMap": true,
      "noImplicitAny": true,
      "skipLibCheck": true
    },
    "include": [
      "./hardhat.config.ts",
      "./scripts/**/*.ts",
      "./test/**/*.ts",
      "./tasks/**/*.ts",
      "./typechain-types/**/*.ts"
    ],
    "exclude": ["node_modules"]
  }